# Non-secret settings for the production environment. Committed to the repo.
# Secrets live in /opt/paperclip/.env on the server (see env.example).
# Replace the example values below before the first deploy.
#
# 生产环境参数（不含密钥，会提交到仓库）。首次部署前把下面的示例值改成你自己的。
# 密钥不要写在这里：ACR 密码、AccessKey 放 GitHub Secrets，其余由 bootstrap.sh 生成。
ENV_NAME=production

# ---- ECS ----
# ECS 所在地域，例如 cn-hangzhou、cn-shanghai、cn-beijing
ALIYUN_REGION=cn-hangzhou
# 部署 Paperclip 的那台 ECS 的实例 ID（控制台实例列表中的 i-xxxx）
ECS_INSTANCE_ID=i-bp10j0feqdxhdnhtxxew

# ---- 容器镜像服务 ACR（与 ECS 同地域）----
# 公网地址：registry.<地域>.aliyuncs.com（CI 推送镜像用）
ACR_REGISTRY=crpi-xsqx0j97ir7afa46.cn-hangzhou.personal.cr.aliyuncs.com
# VPC 内网地址：registry-vpc.<地域>.aliyuncs.com（ECS 拉取镜像用）
ACR_REGISTRY_VPC=crpi-xsqx0j97ir7afa46-vpc.cn-hangzhou.personal.cr.aliyuncs.com
# ACR 命名空间
ACR_NAMESPACE=digital-workforce

# ---- 域名（已备案，A 记录指向 ECS 公网 IP）----
# Paperclip 访问域名
APP_DOMAIN=agent.ai-datum.net
# Keycloak 访问域名
SSO_DOMAIN=sso.ai-datum.net

# ---- Keycloak ----
# realm 名称，一般保持默认
KEYCLOAK_REALM=digital-workforce
# 组织显示名（公司名）
KEYCLOAK_ORG_NAME=FiveGuys
# 组织别名：小写字母/数字/连字符；上线后与公司映射绑定，不要再改
KEYCLOAK_ORG_ALIAS=fiveguys
# 公司邮箱域名，例如 company.com
KEYCLOAK_ORG_DOMAIN=ai-datum.net

# ---- 组件版本（一般保持默认）----
KEYCLOAK_VERSION=26.8.0
POSTGRES_VERSION=17-alpine
CADDY_VERSION=2.10-alpine

# ---- 备份 OSS（与 ECS 同地域，桶设置 30 天生命周期）----
# 备份桶，格式 oss://<桶名>
OSS_BACKUP_BUCKET=oss://bkt-paperclip
# OSS 内网 endpoint：oss-<地域>-internal.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
# RAM role attached to the ECS instance, allowed to write to OSS_BACKUP_BUCKET.
# 绑定到 ECS 的 RAM 角色名（需有备份桶写权限）
OSS_RAM_ROLE=paperclip-backup

# ---- 证书与访问控制 ----
# Let's Encrypt 证书联系邮箱
ACME_EMAIL=63592990@qq.com
# Space-separated CIDRs allowed to open the Keycloak admin console.
# 允许打开 Keycloak 管理台的网段，多个用空格分隔，例如 "1.2.3.4/32 5.6.7.0/24"
ADMIN_ALLOWED_CIDRS=0.0.0.0/0

# ---- 登录页 ----
# 企业登录按钮文字
PAPERCLIP_AUTH_OIDC_LABEL=使用企业账号登录
# 平台名称和 logo（Paperclip 与 Keycloak 登录页；logo 文件见 branding/）
PAPERCLIP_BRAND_NAME=FiveGuys 数字员工平台
PAPERCLIP_BRAND_LOGO_URL=https://agent.ai-datum.net/brand/logo.png

# ---- 模型网关 LiteLLM（specs/006）----
# 网关管理界面与接口地址；需在阿里云 DNS 添加解析到 ECS。只允许 ADMIN_ALLOWED_CIDRS 访问
LLM_DOMAIN=llm.ai-datum.net
# 发布时从 LITELLM_IMAGE 同步到 ACR 的 litellm:<LITELLM_VERSION>
LITELLM_VERSION=1.105.1
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:b7b9e2c306343721802253d0dd9436b9634a2eb4e14da7c7cf06c5c7b7530802
