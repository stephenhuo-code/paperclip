# Local full-stack smoke test environment (stack-smoke.sh). Not for real deploys.
ENV_NAME=local
ALIYUN_REGION=cn-hangzhou
ECS_INSTANCE_ID=i-local
ACR_REGISTRY=local
ACR_REGISTRY_VPC=local
ACR_NAMESPACE=dw
# *.127.0.0.1.nip.io resolves to 127.0.0.1 through public DNS; inside the
# compose network these names are aliases of the caddy container.
APP_DOMAIN=agents.127.0.0.1.nip.io
SSO_DOMAIN=sso.127.0.0.1.nip.io
KEYCLOAK_REALM=digital-workforce
KEYCLOAK_ORG_NAME=Acme
KEYCLOAK_ORG_ALIAS=acme
KEYCLOAK_ORG_DOMAIN=example.cn
KEYCLOAK_VERSION=26.8.0
POSTGRES_VERSION=17-alpine
CADDY_VERSION=2.10-alpine
OSS_BACKUP_BUCKET=oss://local-test-bucket
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_RAM_ROLE=
ACME_EMAIL=ops@example.cn
# Deliberately not matching the Docker gateway, so the admin console is refused.
ADMIN_ALLOWED_CIDRS=10.255.255.0/24
PAPERCLIP_AUTH_OIDC_LABEL=使用企业账号登录
CADDY_TLS_DIRECTIVE=tls internal
PAPERCLIP_EXTRA_CA_CERTS=/caddy-data/caddy/pki/authorities/local/root.crt
PAPERCLIP_AUTH_RATE_LIMIT_ENABLED=false
