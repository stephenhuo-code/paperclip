# Fixed example settings for the deploy tests. The real environments/production.env
# holds live values; tests copy this file over it so they stay deterministic.
ENV_NAME=production
ALIYUN_REGION=cn-hangzhou
ECS_INSTANCE_ID=i-replace-with-your-instance-id
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_REGISTRY_VPC=registry-vpc.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=digital-workforce
APP_DOMAIN=agents.example.cn
SSO_DOMAIN=sso.example.cn
KEYCLOAK_REALM=digital-workforce
KEYCLOAK_ORG_NAME=Acme
KEYCLOAK_ORG_ALIAS=acme
KEYCLOAK_ORG_DOMAIN=example.cn
KEYCLOAK_VERSION=26.8.0
POSTGRES_VERSION=17-alpine
CADDY_VERSION=2.10-alpine
OSS_BACKUP_BUCKET=oss://acme-paperclip-backup
OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
OSS_RAM_ROLE=paperclip-backup
ACME_EMAIL=ops@example.cn
ADMIN_ALLOWED_CIDRS=10.0.0.0/8
PAPERCLIP_AUTH_OIDC_LABEL=使用企业账号登录
PAPERCLIP_BRAND_NAME=Acme 数字员工平台
PAPERCLIP_BRAND_LOGO_URL=https://agents.example.cn/brand/logo.png
