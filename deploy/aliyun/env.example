# 生产服务器上的 /opt/paperclip/.env 模板（只有键名，没有值）。
# bootstrap.sh 首次运行时自动生成这些值；已存在的键不会被覆盖。
# 不要把真实值提交到仓库。不要在这里加入任何 ANTHROPIC_* 变量：
# 模型地址和密钥只配置在各个数字员工（agent）上。

# Paperclip 会话签名密钥
BETTER_AUTH_SECRET=
# agent 调用 Paperclip API 用的 JWT 签名密钥
PAPERCLIP_AGENT_JWT_SECRET=
# 工具调用签名密钥
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# PostgreSQL 超级用户口令（仅用于初始化两个库）
POSTGRES_PASSWORD=
# paperclip 库账号口令
PAPERCLIP_DB_PASSWORD=
# keycloak 库账号口令
KEYCLOAK_DB_PASSWORD=
# Keycloak 临时管理员口令（首次登录后创建正式管理员并修改）
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Keycloak 客户端 paperclip 的 client secret（同时写入 Keycloak 与 Paperclip）
PAPERCLIP_AUTH_OIDC_CLIENT_SECRET=
# Keycloak 组织别名 -> Paperclip 公司 ID，如 {"acme":"<company-uuid>"}；创建首个公司后由管理员填写
PAPERCLIP_AUTH_OIDC_ORG_COMPANY_MAP=
