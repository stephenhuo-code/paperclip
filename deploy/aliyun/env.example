# 生产服务器上的 /opt/paperclip/.env 模板。
# bootstrap.sh 首次运行时：值为空的键自动生成随机密钥（组织映射除外），有默认值的键写入默认值；
# 已存在的键不会被覆盖。
# 不要把真实值提交到仓库。不要在这里加入任何 ANTHROPIC_* 变量：
# 模型地址和密钥只配置在各个数字员工（agent）上。

# Paperclip 会话签名密钥
BETTER_AUTH_SECRET=
# agent 调用 Paperclip API 用的 JWT 签名密钥
PAPERCLIP_AGENT_JWT_SECRET=
# 工具调用签名密钥
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# PostgreSQL 超级用户口令（仅用于初始化两个库）
POSTGRES_PASSWORD=
# paperclip 库账号口令
PAPERCLIP_DB_PASSWORD=
# keycloak 库账号口令
KEYCLOAK_DB_PASSWORD=
# Keycloak 管理员 provisioner 的口令：部署时由 keycloak-config 用它初始化 realm。
# 不要删除 provisioner 账号；日常管理请另建自己的管理员账号。
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Keycloak 客户端 paperclip 的 client secret（同时写入 Keycloak 与 Paperclip）
PAPERCLIP_AUTH_OIDC_CLIENT_SECRET=
# Keycloak 组织别名 -> Paperclip 公司 ID，如 {"acme":"<company-uuid>"}；由 first-run.sh 设置
PAPERCLIP_AUTH_OIDC_ORG_COMPANY_MAP=
# 首次部署为 false，用于注册应急管理员；由 first-run.sh 在创建管理员后改为 true 并重新部署
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# ---- 模型网关 LiteLLM（specs/006）----
# 网关管理密钥（界面首次登录与接口管理用；部署时自动加上 sk- 前缀）
LITELLM_MASTER_KEY=
# 加密网关中保存的上游 Key 的盐。一经生成永远不要修改，否则已保存的 Key 无法解密
LITELLM_SALT_KEY=
# litellm 库账号口令
LITELLM_DB_PASSWORD=
# paperclip 库只读账号口令（gateway-sync 读取运行与任务）
PAPERCLIP_READONLY_DB_PASSWORD=
