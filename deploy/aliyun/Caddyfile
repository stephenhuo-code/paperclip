{
	email {$ACME_EMAIL}
}

# Paperclip (UI + API)
{$APP_DOMAIN} {
	{$CADDY_TLS_DIRECTIVE}
	encode zstd gzip
	# Sign-in page logo (deploy/aliyun/branding), also used by the Keycloak page.
	handle_path /brand/* {
		root * /srv/brand
		file_server
	}
	handle {
		reverse_proxy paperclip:3100
	}
}

# Keycloak sign-in. The admin console is limited to ADMIN_ALLOWED_CIDRS (FR-027);
# the management port (9000, health) is never proxied.
{$SSO_DOMAIN} {
	{$CADDY_TLS_DIRECTIVE}
	@admin_outside_allowlist {
		path /admin /admin/*
		not remote_ip {$ADMIN_ALLOWED_CIDRS}
	}
	respond @admin_outside_allowlist 403
	reverse_proxy keycloak:8080
}

# Model gateway (LiteLLM admin UI and API, specs/006-litellm-gateway-billing).
# Only the admin networks and the containers on this host (Paperclip) may use it.
{$LLM_DOMAIN} {
	{$CADDY_TLS_DIRECTIVE}
	@outside_allowlist {
		not remote_ip {$ADMIN_ALLOWED_CIDRS} private_ranges
	}
	respond @outside_allowlist 403
	reverse_proxy litellm:4000
}
